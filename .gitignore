# Course reference files
/course/
/course_content/

# Local secrets; keep the shareable example
.env
.env.*
!.env.example

# Python environment and caches
.venv/
.venv-wsl/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Generated datasets and model binaries
*.parquet
*.joblib
*.pkl
*.skops
/data/external/*.csv

# Local MLflow state
mlruns/
mlartifacts/
mlflow-server.log

# Generated reports (duplicated in MLflow's own artifact store; regenerated on every run)
/reports/

# Runtime databases and companion files
*.db
*.db-*
*.sqlite
*.sqlite-*

# macOS metadata
.DS_Store

# Dashboard frontend build tooling (dashboard/components/dist/ IS committed -- it's the
# built bundle the Python component serves; only the Node tooling that produces it is not)
dashboard/components/frontend/node_modules/
dashboard/components/frontend/.cache/
# Local exported model packages
/models/

# Persistent local bootstrap Registry and artifacts
/.runtime/


