# Address of the local MLflow service, introduced in a later lesson.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Experiment used to organize taxi-demand training runs.
MLFLOW_EXPERIMENT_NAME=nyc-taxi-demand

# Registry name the trained model is registered under (candidate/champion aliases, not stages).
MLFLOW_MODEL_NAME=nyc-taxi-demand-forecaster
